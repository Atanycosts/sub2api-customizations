[Unit]
Description=Provision dedicated account memory for active Sub2API users
After=sub2api.service sub2api-memory-embeddings.service
Requires=sub2api-memory-embeddings.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/sub2api/provision-account-memory.py
TimeoutStartSec=10min
UMask=0077
Nice=10
